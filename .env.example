# ==============================================================================
# Autonomous Cloud-Based Personal Assistant - Environment Configuration Template
# Copy this file to .env and customize values for local development or production.
# ==============================================================================

# --- Application Server Configuration ---
APP_ENV=development                 # 'development', 'testing', or 'production'
LOG_LEVEL=INFO                      # 'DEBUG', 'INFO', 'WARNING', 'ERROR'
HOST=0.0.0.0
PORT=8080
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# --- User Profile & Localization ---
USER_NAME="Samuel Azuero"
CURRENCY_CODE=COP                   # ISO currency code (COP, USD, EUR)
CURRENCY_SYMBOL=$                   # Currency symbol for UI display

# --- Database & Persistence ---
# SQLite file path or ':memory:' for isolated testing
DATABASE_PATH=data/assistant.db

# --- External Service Mocks (Zero-Key Offline Development) ---
# When true, all external third-party APIs operate in deterministic mock mode.
MOCK_SERVICES=true
MOCK_TELEGRAM=true
MOCK_GMAIL=true
MOCK_CALENDAR=true
MOCK_STT=true
MOCK_RESEARCH=true

# --- Telegram Bot Integration ---
# Obtain token from @BotFather on Telegram (format: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Secret token to authenticate incoming webhook requests (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_SECRET_TOKEN=your_secure_webhook_secret_token_here
# Public HTTPS URL for Cloud Run or ngrok tunnel
TELEGRAM_WEBHOOK_URL=https://your-service.run.app/api/webhook/telegram

# --- Google APIs & Dual Email Integration ---
# Monitored Gmail accounts (Personal and Institutional)
GMAIL_USER_EMAIL=user@example.com
SECONDARY_GMAIL_USER_EMAIL=est.user@unimilitar.edu.co

# Google App Passwords (16 characters generated via Google Account Security)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SECONDARY_GMAIL_APP_PASSWORD=yyyy yyyy yyyy yyyy
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Google OAuth 2.0 Credentials (Optional alternative to App Passwords)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
CALENDAR_ID=primary

# --- AI & Natural Language Processing ---
# Google Gemini API Key for extended conversational reasoning fallback
GEMINI_API_KEY=your_gemini_api_key_here
ENABLE_LLM_FALLBACK=false
GEMINI_MODEL=gemini-2.5-flash

# --- Multi-Account Finance & Default Accounts (Stage 2) ---
# Default accounts managed by the assistant: Efectivo, Nequi, Nu, Daviplata, Bancolombia
DEFAULT_PAYMENT_ACCOUNT=Efectivo
